<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>FoundToIR</AssemblyName>
    <Version>1.0.0</Version>
    <OutputType>Library</OutputType>
  </PropertyGroup>

  <!-- 4.1.6 isn't published on NuGet; 4.1.2 API is identical for what we use and the server's own DLLs are used at runtime -->
  <ItemGroup>
    <PackageReference Include="SPTarkov.Common" Version="4.1.2" ExcludeAssets="runtime" />
    <PackageReference Include="SPTarkov.DI" Version="4.1.2" ExcludeAssets="runtime" />
    <PackageReference Include="SPTarkov.Reflection" Version="4.1.2" ExcludeAssets="runtime" />
    <PackageReference Include="SPTarkov.Server.Core" Version="4.1.2" ExcludeAssets="runtime" />
  </ItemGroup>

</Project>
